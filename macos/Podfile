platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{Flutter-Generated.xcconfig}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end
  # webview_cef（macOS 的 CEF/Chromium WebView）：嵌入 CEF helper 子进程
  # app（多进程渲染）。不加则退回 Chromium 不支持的单进程模式。
  require File.expand_path(
    'Flutter/ephemeral/.symlinks/plugins/webview_cef/macos/embed_cef_helpers.rb', __dir__)
  WebviewCEF.install_helper_phase(installer)

  # webview_cef 的 pod 源码编译必须与所链接的 CEF 二进制同风味：Release/
  # Profile 用 Release 版 CEF（不导出 DCHECK 分支符号，见
  # cef_ref_counted.h 的 ~RefCountedThreadSafeBase），需要 NDEBUG 关闭
  # DCHECK_IS_ON()，否则符号未定义、链接失败。生成的 Pods 工程默认不带
  # NDEBUG，这里按构建配置补上（不要写进 podspec 的 xcconfig——带空格的
  # 框架路径会被 CocoaPods 的 xcconfig 序列化弄坏）。
  installer.pods_project.targets
      .select { |t| t.name == 'webview_cef' }
      .each do |t|
    t.build_configurations.each do |c|
      next unless %w[Release Profile].include?(c.name)
      defs = c.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] if defs.is_a?(String)
      unless defs.include?('NDEBUG=1')
        defs << 'NDEBUG=1'
        c.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
      end
    end
  end
end

post_integrate do |installer|
  # webview_cef 的 CEF 框架名带空格："Chromium Embedded Framework"。
  # CocoaPods 写进 Pods-Runner xcconfig 的 -framework 参数在新版
  # Xcode 的 xcconfig 分词下会被拆成多个词，clang 收到裸的
  # 'Embedded' 'Framework' 文件参数而失败（上游 issue #27/#178）。
  # xcconfig 落盘后统一改写成转义引号形式，任一分词行为下都安全。
  fixes = [
    # CocoaPods 1.17 实际生成的损坏形态（CI 日志实测）：
    #   -ObjC Embedded Framework -framework "Chromium"
    ['-ObjC Embedded Framework -framework "Chromium"',
     '-ObjC -framework \\"Chromium Embedded Framework\\"'],
    # 其余历史/变体形态兜底。
    [/-framework\s+"Chromium Embedded Framework"/,
     '-framework \\"Chromium Embedded Framework\\"'],
    [/-framework\s+Chromium\\ Embedded\\ Framework/,
     '-framework \\"Chromium Embedded Framework\\"'],
    [/-framework\s+Chromium Embedded Framework/,
     '-framework \\"Chromium Embedded Framework\\"'],
  ]
  Dir.glob(File.join(__dir__, 'Pods/Target Support Files/**/*.xcconfig')).each do |f|
    txt = File.read(f)
    fixed = txt
    fixes.each { |pat, rep| fixed = fixed.gsub(pat, rep) }
    File.write(f, fixed) if fixed != txt
  end
end
